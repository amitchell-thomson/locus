# kairosd: single writer to iCloud, HTTP API + MCP on the Tailscale interface.
# Enable: systemctl --user daemon-reload && systemctl --user enable --now kairosd
[Unit]
Description=kairos calendar daemon (API, MCP, scheduler)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.cargo/bin/kairosd --config %h/.config/kairos/config.toml
Restart=always
RestartSec=5
Environment=RUST_LOG=info
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
# Hardening that works for user units without extra privileges.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
UMask=0077
MemoryMax=512M

[Install]
WantedBy=default.target
