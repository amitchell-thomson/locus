[Unit]
Description=Locus nightly — rebuild alias substrate, structure newly ingested documents
Documentation=file:///home/alec/server-projects/locus/docs/obsidian-agent-layer-plan.md
After=network-online.target
Wants=network-online.target
OnFailure=locus-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/alec/server-projects/locus
# systemd's user PATH is the system default and does NOT include ~/.local/bin, where uv,
# rmapi and the `claude` CLI all live. Leaving it implicit is why locus-maintain died on
# six consecutive nights with "`claude` CLI not found on PATH", taking `locus link` with
# it and leaving 1,989 entity surfaces outside the alias substrate. Stated explicitly here
# so no unit depends on what the manager happens to have inherited at login.
Environment=PATH=/home/alec/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 1. link: folds new entity surfaces into entity_aliases. Verdicts are cached in pass_cache,
#    so a run with nothing new costs ~0 API calls.
ExecStart=/home/alec/.local/bin/uv run locus link
# 2. structure: documents this has NEVER looked at (`documents.structured_at IS NULL`, migration
#    0027). It used to be `--ingested-since "2 days ago"`, and a window is not a ledger: anything
#    arriving while this unit was broken — and it was broken for six consecutive nights — fell
#    out of the window and was skipped FOREVER, with nothing able to say which. Live casualty:
#    doc 482, his own handwritten `Optimisation` note. A document is stamped even when it yields
#    nothing, so the empty ones are not re-billed every night.
#    --limit 20 keeps a night's spend bounded while the 162-document backlog drains, the same
#    gradual-fill reasoning as `review --write-questions` below.
ExecStart=/home/alec/.local/bin/uv run locus structure --unstructured --limit 20
# Enrol a few propositions from BLESSED objects into the SM-2 schedule. Deterministic and
# free (no model), idempotent, and deliberately gradual — it adds a handful a night so the
# recall section fills at the rate he actually answers, instead of dumping a backlog.
# Without this the schedule stays at zero rows and the daily page's recall section is
# permanently empty, which is how it sat from the day the table was created.
ExecStart=/home/alec/.local/bin/uv run locus review --enrol
# 4. Give newly-enrolled propositions a QUESTION to ask. Billed (claude -p, subscription).
#    Without one `resolve_prompt` returns the proposition itself as the prompt — the page shows
#    him the answer and asks him to recall it, which is why the recall loop had no answerable
#    step. Capped per run so a night's spend is bounded and the schedule fills gradually.
ExecStart=/home/alec/.local/bin/uv run locus review --write-questions 8
# 5. Write (and refresh) the reason each proposed paper is on the shelf. Billed (claude -p).
#    The deterministic `why` is a cosine distance — "fit 0.76" — which is a fact about the
#    ranker, not a reason to read anything. A reason older than a week is rewritten against his
#    current threads, which is also what earns a proposal a second appearance on the Read page.
# 5a. Score what he is READING against his projects — including books he added himself, which
#     arrived with no relevance at all. Free and local (embeddings + a cosine), so it runs before
#     the billed step and gives the reason-writer something to explain.
# 4b. What each marked passage MEANT (important / not understood / an idea), and the fate that
#     follows. Billed (claude -p) for the inference; acting on it is a free join. A mark's page
#     must have been untouched 12h first, so this never reacts to ink still being written, and a
#     guess below the confidence floor is held for `locus decide` rather than acted on.
ExecStart=/home/alec/.local/bin/uv run locus intent --act
ExecStart=/home/alec/.local/bin/uv run locus discover --link-reading
ExecStart=/home/alec/.local/bin/uv run locus discover --write-why 10
# 6. Record that the UNIT completed. It is nine ExecStart lines rather than one command, so
#    nothing else is in a position to say it finished — and "no row" is indistinguishable from
#    "did not run tonight", which is exactly how six consecutive failures stayed invisible.
ExecStart=/home/alec/.local/bin/uv run locus record maintain --ok
TimeoutStartSec=7200
Nice=15
IOSchedulingClass=idle
