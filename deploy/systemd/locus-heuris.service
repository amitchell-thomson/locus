[Unit]
Description=heuris (H1): index mail, calendar, chats and repos into heuris.db
Documentation=file:///home/alec/server-projects/locus/docs/redesign/slices/h1-index-and-tools.md
After=network-online.target locus-kairosd.service
Wants=network-online.target
OnFailure=locus-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/alec/server-projects/locus
Environment=PATH=/home/alec/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Free: embedding runs on the local GPU (nomic via Ollama); no model call is made. Incremental by
# content hash, so an unchanged tick embeds nothing.
ExecStart=/home/alec/.local/bin/uv run locus heuris index all
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=idle
