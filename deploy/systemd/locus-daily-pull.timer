[Unit]
Description=Check hourly whether the annotated daily page has come back from the tablet

[Timer]
OnBootSec=15min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
# A missed window runs once on resume. Routing is idempotent by (date, anchor) and the pull is
# hash-guarded, so a late or repeated run can neither double-grade nor double-spend.
Persistent=true

[Install]
WantedBy=timers.target
