[Unit]
Description=Locus Loop A — pull reMarkable handwriting, transcribe, enrich, ingest
Documentation=file:///home/alec/server-projects/locus/docs/obsidian-agent-layer-plan.md
# The ingest lock (flock) enforces one ingest at a time, but not starting on top of a
# structure run keeps the journal readable and avoids lock-contention noise in the logs.
After=network-online.target
Wants=network-online.target
OnFailure=locus-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/alec/server-projects/locus
# systemd's user PATH is the system default and does NOT include ~/.local/bin, where uv,
# rmapi and the `claude` CLI all live. Leaving it implicit is why locus-maintain died on
# six consecutive nights with "`claude` CLI not found on PATH", taking `locus link` with
# it and leaving 1,989 entity surfaces outside the alias substrate. Stated explicitly here
# so no unit depends on what the manager happens to have inherited at login.
Environment=PATH=/home/alec/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# capture-sync is BILLED (Sonnet vision) but idempotent: a per-uuid raster hash means an
# unchanged notebook costs nothing, so a frequent timer only spends when you actually write.
ExecStart=/home/alec/.local/bin/uv run locus capture-sync
# Never let a wedged rmapi/model call hold the ingest lock into the next window.
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=idle
