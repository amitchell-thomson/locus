# Locus configuration template. Copy to config.toml and adjust paths.
# NO SECRETS HERE. The Claude API key comes from the ANTHROPIC_API_KEY env var.

[ollama]
host          = "http://localhost:11434"
embed_model   = "nomic-embed-text"
ingest_model  = "qwen2.5:7b-instruct-q5_K_M"  # settled by the §11.C benchmark (2026-06-05): beats llama3.1:8b-q5_K_M 3.96 vs 3.65 overall
num_ctx       = 8192              # ingest context window; >Ollama default 4096 so prop-dense sections don't slide out mid-generation

[paths]
db            = "vault/locus.db"
raw_store     = "vault/raw"
incoming      = "vault/incoming"
notes         = "vault/notes"

[embed]
dim           = 768               # locked to nomic-embed-text; changing => full re-embed
chunk_tokens  = 512

[retrieve]
proposition_top_k    = 10         # highest-signal claims, searched as first-class units
fine_top_k           = 20         # L3 chunks
section_top_k        = 5          # L2 section summaries
figure_top_k         = 8          # figure caption+description vectors (step 11)
rerank_top_k         = 8          # survivors after cross-encoder rerank
per_doc_cap          = 3          # max units per document among survivors (diversity; relaxed if underfull)
context_token_budget = 100000     # cap on assembled context to the Claude API call
min_rerank_score     = 0.22       # confidence floor on cross-encoder logits (~-11..+11). Calibrated
                                  # 2026-06-05 (scripts/calibrate_rerank_threshold.py): weakest
                                  # expected-doc score +0.92, strongest negative-control -0.48 —
                                  # midpoint 0.22. Refill never pads the top-k with below-floor
                                  # candidates; a best-survivor below the floor flags the result
                                  # LOW CONFIDENCE (signal, not filter). Recalibrate after bulk ingest.
# Self-ingestion exclusion (2026-06-09 audit): the locus repo indexes itself; 1000+ chunks of
# its own RAG/test/README code compete with and contaminate real queries. Dropped from the
# candidate pool by default; `locus retrieve --include-excluded` queries it when you mean to.
exclude_source_uris  = ["/home/alec/server-projects/locus"]
# Down-weight for maturity=rough capture notes (agent-layer §6.1): subtracted from the
# cross-encoder score of rough-doc candidates before the final sort (a logit penalty, NOT a
# multiplier — the pre-rerank arm scores don't order results and a multiplier on signed logits
# is incoherent). Flag/down-weight, never filter. Inert until Loop A lands rough notes; eval-tune
# then (locus eval --suite retrieval). 0 = off.
rough_penalty        = 1.5
# Down-weight engineering coursework (246/295 docs, 81% of propositions, 97% of figures;
# 87% of cross-doc canonicals reachable only through it). Subtractive penalty on the
# cross-encoder score — down-weight, NEVER filter: a coursework doc that genuinely answers
# a coursework question still out-scores the penalty. Reversible; delete nothing.
# MEASURED 2026-07-29: a coursework penalty of 2.0 changed NOTHING — quant queries already
# returned 0/8 coursework survivors and coursework queries correctly returned 8/8. The
# cross-encoder already discriminates; the dilution is in the CONCEPT/link substrate, not
# retrieval. Left OFF rather than set to a value that implies an effect it does not have.
category_penalty     = {}

[mathocr]
# Math-aware page OCR: pages whose text layer is damaged or math-dense are re-read by an
# OCR-to-markup engine; recovered markdown+LaTeX replaces the page text (QC-guarded).
# Engine picked by benchmark on flagged corpus pages (eval-artifacts/mathocr/report.md):
# GOT-OCR2.0 won on risk asymmetry — 0 hallucinations / 0 engine failures (fidelity 0.93,
# prose 4.9/5) vs qwen-VL 0.97 with one invented equation and Nougat with 4/10 failures.
engine        = "got"             # "got" (transformers, mathocr extra) | "qwen" (Ollama VLM) | "off"
model         = "qwen2.5vl:7b"    # Ollama model used by the "qwen" engine

[figures]
# Figure extraction + VLM description (step 11, §15.1). Tier 1: detect + render figure PNGs
# to the raw store with paired captions. Tier 2: local VLM describes; caption+description is
# embedded (figure_vectors). Tier 3: top survivors attach as images to the Claude call.
# Thresholds lean STRICT — a missed figure is benign; a junk figure burns a VLM call.
enabled          = true
model            = "qwen2.5vl:7b" # Ollama VLM (already pulled for the mathocr "qwen" engine)
engine           = "llamacpp"     # judged gate PASS 2026-06-06 (eval-artifacts/figures/report.md):
                                  # faith 3.10 vs 3.00, halluc 20=20, 2.1 s/fig vs 27.5 (13x) —
                                  # REQUIRES the f16 mmproj below (Q8_0 auto-pair FAILED the gate)
llamacpp_binary  = "/home/alec/.local/opt/llama-b9544/llama-server"  # official Vulkan build b9544
llamacpp_mmproj  = "/home/alec/.cache/huggingface/mmproj-Qwen2.5-VL-7B-Instruct-f16.gguf"
                                  # f16 vision tower: the Q8_0 auto-pair FAILED the judge gate
                                  # (faith 2.80 vs 3.10, halluc 24 vs 18 — quantized visual
                                  # features invent more); f16 is the retest
render_slides    = true           # needs `soffice` on PATH; absent => warn + skip, never quarantine
min_area_frac    = 0.03
max_area_frac    = 0.92
min_vector_paths = 8
max_text_density = 2.0            # diagrams <=1.6 corpus-measured; prose/tables >=2.2
caption_max_gap_pt = 60.0
max_per_page     = 4
image_cap        = 3              # max figure images per Claude call / MCP reply

[generation]
model         = "claude-sonnet-4-6"   # RAG generation model; tune as needed

[mcp]
# The MCP `query` tool generates server-side -> billed Claude API calls. `retrieve` and the read
# tools are local-only (free). Keep false so the server never advertises a billable tool unless
# you opt in (or pass `locus mcp --enable-query`).
enable_query  = false
include_figure_images = true      # attach retrieved figure images as MCP image content blocks

[repos]
# Tracked code repositories (step 10): HEAD check inside `locus watch-repo`; re-ingest only
# on new commits, and INCREMENTALLY (locus/repo_sync.py — only the files a commit changed).
# Manual: `locus sync [--force]`.
paths = [
  "/home/alec/server-projects/digest",
  "/home/alec/server-projects/locus",
  "/home/alec/server-projects/oxai",
  "/home/alec/server-projects/quant-data",
  "/home/alec/server-projects/regime-conditioned-equity-ml",
  "/home/alec/server-projects/tanker-flow",
]
check_interval = 3600
# Repo-relative globs excluded from ingest. The locus repo indexes itself, and these
# files carry the labelled eval queries verbatim — answer keys that outrank real
# content on their own questions (round-5 audit).
exclude_globs = [
  "locus/eval/retrieval_eval.py",
  "tests/test_retrieve.py",
  "tests/test_link_aliases.py",
  "tests/test_pass_hygiene.py",
]

[alias]
# Cross-document entity-alias resolution (`locus link`, step 12). Deterministic tiers run
# first; remaining lookalike clusters are adjudicated by the Claude API (billed — only on
# new/changed clusters, verdicts are cached). Thresholds lean conservative: a missed merge
# is fragmentation, a wrong merge corrupts the link substrate.
block_threshold   = 0.86   # cosine floor (nomic name embeddings) for candidate edges
min_token_overlap = 0.34   # token-Jaccard guard on candidate edges
max_cluster_size  = 8      # clusters larger than this skip the LLM (cost guard)
min_merge_len     = 4      # names shorter than this never merge (homonym risk: 'var', 'P2')
use_llm           = true   # false = deterministic tiers only (no API)
api_call_interval = 1.5    # seconds between adjudication API calls (rate-limit politeness; 0 = off)

[obsidian]
# Read-only Obsidian projection (`locus export-obsidian`, §13). A one-way, regenerable
# render of the corpus as a browsable vault — never read back, never in the retrieval path,
# joins-only (no API). Run AFTER `locus link` (entity notes need the alias substrate). The
# exporter owns only its docs/ and entities/ subtrees and never touches .obsidian/. View it
# from the Mac by rsync-pulling the tree (see docs/obsidian-projection-plan.md §10).
out_dir          = "vault/obsidian"   # exporter-owned root (gitignored, regenerable)
top_related      = 10                 # doc<->doc related edges per note (matches related_documents)
min_cluster_docs = 2                  # emit a canonical entity note only if it spans >= this many docs
emit_entity_notes = true              # false = docs-only graph (no canonical entity notes)

[concepts]
# Code concept-entity pass (`ingest/concepts.py`, §1.2 Link). Extracts the DOMAIN
# concepts a repository implements/studies from its narrative (synthesis + README + file
# summaries, never raw code) into concept/method/tool/dataset/metric/theorem entities, so
# code projects link to the papers they are built on. A doc-level local-qwen pass run for
# source_type=code; `locus link` then folds the concepts into the alias substrate. Backfill
# existing repos with `uv run python -m scripts.backfill_code_concepts`.
enabled     = true   # run the concept pass at ingest for code repos
max_per_doc = 40     # cap concepts written per repo (a runaway README is the failure mode)
# stoplist  = []     # override the built-in generic-term stoplist (empty = built-in default)

[reading]
# Server->device reading delivery (`locus read <path|dir>`, agent-layer §8.5, Phase 0.5).
# Renders markdown -> a device-tuned PDF (pandoc md->typst -> typst compile; needs the
# `[reading]` extra) and `rmapi put`s it to the tablet. Geometry defaults target the reMarkable
# Paper Pro screen (2160x1620 @229dpi => 7.07x9.43in) so text renders at its true point size.
# Absolute rmapi path: systemd timers / non-interactive shells don't have ~/.local/bin on PATH.
rmapi_binary   = "/home/alec/.local/bin/rmapi"
target_folder  = "Locus"   # device folder that delivered docs land in
page_width_in  = 7.07      # PDF page width (in) — Paper Pro screen width
page_height_in = 9.43      # PDF page height (in) — Paper Pro screen height
margin_in      = 0.5       # page margin (in)
font_pt        = 11.0      # body text size (pt)

[agent]
# Agent-layer orchestration (agent-layer plan §10, Phase 1). Capture/enrichment loops run
# language tasks through headless `claude -p` (subscription), metered by a cost ledger.
model              = "haiku"   # claude -p model for durable agent passes (Phase-0 routing choice)
daily_cost_cap_usd = 5.0       # soft daily claude -p spend cap (USD), summed from agent_runs; omit for none

[ingest]
# Per-pass ingest LLM routing (agent-layer §7). 'local' = the local qwen model (Ollama, default);
# a Claude alias ('haiku'/'sonnet') or model id routes that pass to the METERED Anthropic SDK — the
# right channel for high-volume small passes (cheap Haiku, ~$15-20 for a full re-ingest, cents/day
# ongoing). Embeddings + math-OCR are ALWAYS local. Empty = every pass local (current, no metered
# spend). Durable passes routed to Haiku (metered SDK) — fixes local CPU/GPU ingest slowness:
pass_routing = { summarize = "haiku", propositions = "haiku", entities = "haiku", synthesis = "haiku", gaps = "haiku", concepts = "haiku" }

[capture]
# Loop A — reMarkable handwriting capture (agent-layer §8.1). The device pushes each changed
# notebook to staging_dir as <uuid>.pdf; capture maps it to its name+folder via rmapi and files
# it as a rough note. folder_category overrides the built-in map (capture/remarkable.py).
staging_dir      = "/home/alec/remarkable-import"
rmapi_binary     = "/home/alec/.local/bin/rmapi"   # absolute: systemd timers lack ~/.local/bin on PATH
excluded_folders = ["trash", "Locus", "admin", "reading_list"]     # not Loop-A handwriting capture. reading_list holds BOOKS being read: the staged PDF is
                                                   # the device render with the published page and the owner's ink flattened
                                                   # together, so vision transcription cannot tell his margin note from the
                                                   # author's sentence — and note-category docs are read as HIS words by
                                                   # belief-position extraction. Waits for Loop B (§8.2), which separates
                                                   # highlight/margin/underline from source text.
default_category = "note"                           # handwriting is a coarse-KIND note by default
# category is a coarse KIND facet, not the organisation: the folder is kept as note provenance +
# drives concept linking, so only genuine-KIND folders override (else default_category=note).
# folder_category = { engineering = "coursework", quantum_ml = "coursework", projects = "project" }
