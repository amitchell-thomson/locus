[Unit]
Description=Locus nightly — structure newly ingested documents
Documentation=file:///home/alec/server-projects/locus/docs/obsidian-agent-layer-plan.md
After=network-online.target
Wants=network-online.target
OnFailure=locus-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/alec/server-projects/locus
# systemd's user PATH is the system default and does NOT include ~/.local/bin, where uv,
# rmapi and the `claude` CLI all live. Leaving it implicit is why locus-maintain died on
# six consecutive nights with "`claude` CLI not found on PATH", taking `locus link` with
# it and leaving 1,989 entity surfaces outside the alias substrate. Stated explicitly here
# so no unit depends on what the manager happens to have inherited at login.
Environment=PATH=/home/alec/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Slice 0.3 (2026-10-19): everything that fed the daily page is off. Gone from this unit: `link`
# (nightly word-matching links, retired per D1; the linking job of Slice 5 replaces it), recall
# enrolment and question writing (`review --enrol`, `--enrol-concepts`, `--write-questions`,
# `--write-concept-questions`), `intent --act`, `review --answer-marks`, `link --connections`,
# `evolution --store-tensions` and `discover --link-reading`/`--write-why`. The code stays until
# its removal commit later in the slice. Without `link`, new entity surfaces are not folded into
# entity_aliases, so `structure` cannot propose a concept that only a new document attests.
#
# structure: documents this has NEVER looked at (`documents.structured_at IS NULL`, migration
# 0027). It used to be `--ingested-since "2 days ago"`, and a window is not a ledger: anything
# arriving while this unit was broken — and it was broken for six consecutive nights — fell
# out of the window and was skipped FOREVER, with nothing able to say which. Live casualty:
# doc 482, his own handwritten `Optimisation` note. A document is stamped even when it yields
# nothing, so the empty ones are not re-billed every night. --limit 20 bounds a night's spend.
ExecStart=/home/alec/.local/bin/uv run locus structure --unstructured --limit 20
# Record that the UNIT completed. Nothing else is in a position to say it finished — and "no
# row" is indistinguishable from "did not run tonight", which is exactly how six consecutive
# failures stayed invisible.
ExecStart=/home/alec/.local/bin/uv run locus record maintain --ok
TimeoutStartSec=7200
Nice=15
IOSchedulingClass=idle
