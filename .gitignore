# macOS junk
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Secrets: API keys live here, loaded into the env at runtime. NEVER commit.
.env

# Local config (may contain machine-specific paths; secrets come from env, never here)
config.toml

# The data directory (database, raw store, drop zone, notes, backups, cache, logs, the Obsidian
# export): local data, never committed. Called `vault/` until 2026-10-19 (migration 0037).
/data/*
!/data/.gitkeep

eval-artifacts/
.claude/scheduled_tasks.lock
ingest-*.log

# Transient run logs (re-ingest / eval output; results live in PLAN.md)
reingest-*.log
eval-*.log

# Scratch that must never be tracked (swept in by an over-broad `git add -A`, 2026-08-01)
.claude/worktrees/
config.toml.bak-*
scripts/benchmarks/*.log
scripts/benchmarks/*_out.json


# Rust workspace (crates/)
/target/
*.pending-snap
