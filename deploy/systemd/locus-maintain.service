[Unit]
Description=Locus nightly — rebuild alias substrate, structure newly ingested documents
Documentation=file:///home/alec/server-projects/locus/docs/obsidian-agent-layer-plan.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/alec/server-projects/locus
# systemd's user PATH is the system default and does NOT include ~/.local/bin, where uv,
# rmapi and the `claude` CLI all live. Leaving it implicit is why locus-maintain died on
# six consecutive nights with "`claude` CLI not found on PATH", taking `locus link` with
# it and leaving 1,989 entity surfaces outside the alias substrate. Stated explicitly here
# so no unit depends on what the manager happens to have inherited at login.
Environment=PATH=/home/alec/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 1. link: folds new entity surfaces into entity_aliases. Verdicts are cached in pass_cache,
#    so a run with nothing new costs ~0 API calls.
ExecStart=/home/alec/.local/bin/uv run locus link
# 2. structure: ONLY documents ingested in the last two days. --ingested-since (not --since,
#    which filters on the AUTHORED date) is what makes this safe to schedule: a nightly run
#    over the whole corpus would re-bill every document every night for no new information.
#    Two days rather than one so a missed window does not silently skip a day's capture.
ExecStart=/bin/sh -c '/home/alec/.local/bin/uv run locus structure --ingested-since "$(date -d "2 days ago" +%%Y-%%m-%%d)"'
# Enrol a few propositions from BLESSED objects into the SM-2 schedule. Deterministic and
# free (no model), idempotent, and deliberately gradual — it adds a handful a night so the
# recall section fills at the rate he actually answers, instead of dumping a backlog.
# Without this the schedule stays at zero rows and the daily page's recall section is
# permanently empty, which is how it sat from the day the table was created.
ExecStart=/home/alec/.local/bin/uv run locus review --enrol
TimeoutStartSec=7200
Nice=15
IOSchedulingClass=idle
