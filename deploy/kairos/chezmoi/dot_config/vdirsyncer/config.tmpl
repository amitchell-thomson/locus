# vdirsyncer for kairos — managed by chezmoi.
{{- if eq .chezmoi.os "darwin" }}
# Mac: READ-ONLY pull from iCloud. Only kairosd (on compute-node) writes.
{{- else }}
# compute-node: read-write; kairosd is the single writer to iCloud.
{{- end }}

[general]
status_path = "~/.local/share/kairos/vdirsyncer-status/"

[pair icloud]
a = "icloud_remote"
b = "icloud_local"
collections = ["from a"]
metadata = ["displayname", "color"]
# iCloud is the source of truth.
conflict_resolution = "a wins"

[storage icloud_remote]
type = "caldav"
url = "https://caldav.icloud.com/"
item_types = ["VEVENT"]
{{- if eq .chezmoi.os "darwin" }}
username.fetch = ["command", "security", "find-generic-password", "-w", "-s", "kairos-apple-id"]
password.fetch = ["command", "security", "find-generic-password", "-w", "-s", "kairos-icloud"]
read_only = true
{{- else }}
username.fetch = ["command", "cat", "{{ .chezmoi.homeDir }}/.config/kairos/secrets/apple-id"]
password.fetch = ["command", "cat", "{{ .chezmoi.homeDir }}/.config/kairos/secrets/icloud-app-password"]
{{- end }}

[storage icloud_local]
type = "filesystem"
path = "~/.local/share/kairos/vdir/"
fileext = ".ics"
