# kairosd: the calendar daemon, single writer to iCloud, HTTP API + MCP on the Tailscale interface
# (kairos/CLAUDE.md). Built from this repository by deploy/server-sync.sh (`cargo install` into
# ~/.cargo/bin) and restarted only when that build ran. Was `kairosd.service` from the separate
# kairos repository until 2026-10-24 (ADR-008); same binary path, config, port and data.
[Unit]
Description=kairos calendar daemon (API, MCP, scheduler)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.cargo/bin/kairosd --config %h/.config/kairos/config.toml
Restart=always
RestartSec=5
Environment=RUST_LOG=info
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
# Hardening that works for user units without extra privileges.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
UMask=0077
MemoryMax=512M

[Install]
WantedBy=default.target
