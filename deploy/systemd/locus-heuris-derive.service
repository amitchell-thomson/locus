[Unit]
Description=heuris (H2): facts from mail and the calendar, records and briefs, batched on the API credit
Documentation=file:///home/alec/server-projects/locus/docs/redesign/slices/h2-what-is-true-now.md
After=network-online.target
Wants=network-online.target
OnFailure=locus-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/alec/server-projects/locus
Environment=PATH=/home/alec/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Collects the batches earlier runs submitted, then submits what changed. Paced by the credit
# guard (agent/claude.credit_allows): a run over the day's allowance submits nothing and says so.
ExecStart=/home/alec/.local/bin/uv run locus heuris derive
TimeoutStartSec=1800
Nice=10
