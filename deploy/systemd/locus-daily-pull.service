[Unit]
Description=Locus daily page — read the annotated page back off the tablet and route it
Documentation=file:///home/alec/server-projects/locus/docs/obsidian-agent-layer-plan.md
# Needs the device receiver up: the tablet pushes changed documents into the staging dir over
# the tailnet, and this reads the page from there. Ordered after it, but not bound to it — a
# missing staged file is reported as "not pushed back yet", never an error.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/alec/server-projects/locus
# systemd's user PATH is the system default and does NOT include ~/.local/bin, where uv,
# rmapi and the `claude` CLI all live. Leaving it implicit is why locus-maintain died on
# six consecutive nights with "`claude` CLI not found on PATH", taking `locus link` with
# it and leaving 1,989 entity surfaces outside the alias substrate. Stated explicitly here
# so no unit depends on what the manager happens to have inherited at login.
Environment=PATH=/home/alec/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# BILLED, but only when the page actually changed: the pull is hash-guarded, so a page nobody
# has written on since the last run costs nothing at all. That is what makes an hourly cadence
# affordable — corrections land within the hour instead of waiting for the next morning.
ExecStart=/home/alec/.local/bin/uv run locus daily-pull
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=idle
